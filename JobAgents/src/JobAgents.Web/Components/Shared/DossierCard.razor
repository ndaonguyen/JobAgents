@namespace JobAgents.Web.Components.Shared

<div class="card mb-3">
    <div class="card-header d-flex justify-content-between align-items-center">
        <div>
            <strong>@Dossier.Match.Posting.Title</strong>
            <span class="text-muted">@Dossier.Match.Posting.Company · @Dossier.Match.Posting.Location</span>
            @if (!string.IsNullOrWhiteSpace(Dossier.Match.Posting.Url))
            {
                <span class="badge bg-light text-dark border ms-1">@SourceHostUtil.From(Dossier.Match.Posting.Url)</span>
            }
            @if (!string.IsNullOrWhiteSpace(Dossier.Match.Posting.PostedDate))
            {
                <span class="badge bg-light text-dark border ms-1">🗓 @Dossier.Match.Posting.PostedDate</span>
            }
            else
            {
                <span class="badge bg-light text-muted border ms-1" title="No posting date was detected for this result">
                    🗓 date n/a
                </span>
            }
        </div>
        <div class="d-flex align-items-center gap-1">
            @{
                var level = Seniority.DetectFromPosting(Dossier.Match.Posting);
            }
            @if (level != SeniorityLevel.Unknown)
            {
                <span class="badge bg-light text-dark border" title="Seniority detected from the posting title">
                    @level
                </span>
            }
            <span class="badge bg-primary">Fit @Dossier.Match.Score/100</span>
        </div>
    </div>
    <div class="card-body">
        <p class="card-text">@Dossier.Match.Rationale</p>

        @if (Dossier.Match.MatchedSkills.Count > 0)
        {
            <div class="mb-2">
                @foreach (var skill in Dossier.Match.MatchedSkills)
                {
                    <span class="badge bg-success me-1">@skill</span>
                }
            </div>
        }
        @if (Dossier.Match.Gaps.Count > 0)
        {
            <div class="mb-2">
                @foreach (var gap in Dossier.Match.Gaps)
                {
                    <span class="badge bg-warning text-dark me-1">gap: @gap</span>
                }
            </div>
        }

        @{
            var summary = Dossier.Match.Posting.Summary;
            var description = Dossier.Match.Posting.Description;
            // Show the full description only when it adds something beyond the summary.
            var hasFullDescription = !string.IsNullOrWhiteSpace(description)
                && !string.Equals(description?.Trim(), summary?.Trim(), StringComparison.Ordinal);
        }
        @if (!string.IsNullOrWhiteSpace(summary) || hasFullDescription)
        {
            <div class="mb-2">
                <h6>📋 Role &amp; requirements</h6>
                @if (!string.IsNullOrWhiteSpace(summary))
                {
                    <p class="small mb-1">@summary</p>
                }
                @if (hasFullDescription)
                {
                    <details>
                        <summary class="small text-primary" style="cursor: pointer;">Show full posting</summary>
                        <div class="small text-muted mt-1" style="white-space: pre-wrap; word-break: break-word;">@description</div>
                    </details>
                }
            </div>
        }

        <div class="row mt-3">
            <div class="col-md-6 mb-2">
                <h6>🏢 Company</h6>
                @if (Dossier.Company is { } company)
                {
                    <p class="small mb-1">@company.Summary</p>
                    <ul class="small mb-0">
                        @foreach (var highlight in company.Highlights)
                        {
                            <li>@highlight</li>
                        }
                    </ul>
                }
                else if (OnResearchCompany.HasDelegate)
                {
                    @if (ResearchingCompany)
                    {
                        <span class="spinner-border spinner-border-sm" role="status"></span>
                        <span class="text-muted small ms-1">Researching company…</span>
                    }
                    else
                    {
                        <button class="btn btn-sm btn-outline-success" @onclick="OnResearchCompany"
                                title="Run a web search to research this company (uses Tavily)">
                            🏢 Research company
                        </button>
                    }
                }
            </div>

            <div class="col-md-6 mb-2">
                <h6>💰 Salary</h6>
                @if (Dossier.Salary is { } salary)
                {
                    <p class="small mb-1">@FormatSalary(salary)</p>
                    <p class="small text-muted mb-0">@salary.Basis</p>
                }
                else if (OnResearchSalary.HasDelegate)
                {
                    @if (ResearchingSalary)
                    {
                        <span class="spinner-border spinner-border-sm" role="status"></span>
                        <span class="text-muted small ms-1">Estimating salary…</span>
                    }
                    else
                    {
                        <button class="btn btn-sm btn-outline-success" @onclick="OnResearchSalary"
                                title="Run a web search for market salary data (uses Tavily)">
                            💰 Research salary
                        </button>
                    }
                }
            </div>
        </div>

        <div class="mt-2">
            <h6>🎤 Interview prep</h6>
            @if (Dossier.Interview is { } interview && interview.LikelyQuestions.Count > 0)
            {
                <ul class="small mb-1">
                    @foreach (var q in interview.LikelyQuestions)
                    {
                        <li>@q</li>
                    }
                </ul>
                @if (interview.PrepNotes.Count > 0)
                {
                    <p class="small text-muted mb-0">@string.Join(" · ", interview.PrepNotes)</p>
                }
            }
            else if (OnResearchInterview.HasDelegate)
            {
                @if (ResearchingInterview)
                {
                    <span class="spinner-border spinner-border-sm" role="status"></span>
                    <span class="text-muted small ms-1">Preparing interview guidance…</span>
                }
                else
                {
                    <button class="btn btn-sm btn-outline-success" @onclick="OnResearchInterview"
                            title="Generate likely interview questions and prep notes">
                        🎤 Research interview prep
                    </button>
                }
            }
        </div>

        <div class="mt-2 d-flex gap-2 align-items-center">
            @if (!string.IsNullOrWhiteSpace(Dossier.Match.Posting.Url))
            {
                var isListing = SourceHostUtil.IsListing(Dossier.Match.Posting.Url);
                <a class="btn btn-sm @(isListing ? "btn-outline-secondary" : "btn-outline-primary")"
                   href="@Dossier.Match.Posting.Url" target="_blank"
                   title="@(isListing ? "This link opens a job-board search/listing page (multiple jobs), not a single posting." : "Open the job posting")">
                    @(isListing ? "Search results ↗" : "View posting")
                </a>
            }
        </div>

        @if (EnableFeedback)
        {
            <div class="border-top mt-3 pt-2">
                <label class="form-label small mb-1">
                    Your score for this match <span class="text-muted">(feeds the eval calibration set)</span>
                </label>
                <div class="input-group input-group-sm" style="max-width: 460px;">
                    <input type="number" class="form-control" min="0" max="100" style="max-width: 90px;"
                           placeholder="0-100" @bind="_humanScore" />
                    <input type="text" class="form-control"
                           placeholder="why? (optional — e.g. hallucinated Swift, should rank higher)"
                           @bind="_note" />
                    <button class="btn btn-outline-primary" type="button"
                            @onclick="SubmitScoreAsync"
                            disabled="@(_saving || _humanScore is null or < 0 or > 100)">
                        Save
                    </button>
                </div>
                @if (_saved)
                {
                    <span class="small text-success">Saved ✓ (agent said @Dossier.Match.Score/100)</span>
                }
            </div>
        }
    </div>
</div>

@code {
    /// <summary>A human score submitted for one match: 0-100 plus an optional reason.</summary>
    public sealed record ScoreSubmission(int Score, string? Note);

    [Parameter, EditorRequired] public required JobDossier Dossier { get; set; }
    // On-demand, per-piece research. Each button shows only when its callback is wired and that piece
    // is still missing; the matching Researching* flag swaps it for a spinner while the agent runs.
    [Parameter] public EventCallback OnResearchCompany { get; set; }
    [Parameter] public EventCallback OnResearchSalary { get; set; }
    [Parameter] public EventCallback OnResearchInterview { get; set; }
    [Parameter] public bool ResearchingCompany { get; set; }
    [Parameter] public bool ResearchingSalary { get; set; }
    [Parameter] public bool ResearchingInterview { get; set; }

    /// <summary>Shows the inline scoring control. The host wires <see cref="OnSubmitScore"/> to persist it.</summary>
    [Parameter] public bool EnableFeedback { get; set; }
    [Parameter] public EventCallback<ScoreSubmission> OnSubmitScore { get; set; }

    private int? _humanScore;
    private string? _note;
    private bool _saving;
    private bool _saved;

    private async Task SubmitScoreAsync()
    {
        if (_humanScore is not (>= 0 and <= 100) || !OnSubmitScore.HasDelegate)
            return;

        _saving = true;
        try
        {
            var note = string.IsNullOrWhiteSpace(_note) ? null : _note!.Trim();
            await OnSubmitScore.InvokeAsync(new ScoreSubmission(_humanScore.Value, note));
            _saved = true;
        }
        finally
        {
            _saving = false;
        }
    }

    private static string FormatSalary(SalaryEstimate s)
    {
        if (s.Low is null && s.Median is null && s.High is null)
            return "No reliable estimate.";
        var parts = new List<string>();
        if (s.Low is { } low) parts.Add($"{low:N0}");
        if (s.Median is { } median) parts.Add($"~{median:N0}");
        if (s.High is { } high) parts.Add($"{high:N0}");
        return $"{string.Join(" – ", parts)} {s.Currency}";
    }
}
