<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>JobAgents.Api</RootNamespace>
    <AssemblyName>JobAgents.Api</AssemblyName>
    <!--
      Reuse the SAME user-secrets store as JobAgents.Web so the OpenAI / Anthropic / Tavily keys
      configured for the Blazor app are picked up by the API with no re-entry.
    -->
    <UserSecretsId>jobagents-web-dev</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../JobAgents.Application/JobAgents.Application.csproj" />
    <ProjectReference Include="../JobAgents.Infrastructure/JobAgents.Infrastructure.csproj" />
    <ProjectReference Include="../JobAgents.Shared/JobAgents.Shared.csproj" />
  </ItemGroup>

</Project>
