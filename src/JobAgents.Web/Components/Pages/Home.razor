    // A typed custom location takes precedence over the dropdown selection.
    private string EffectiveLocation =>
        string.IsNullOrWhiteSpace(_customLocation) ? _location : _customLocation.Trim();

    private bool HasExactDates => _fromDate is not null || _toDate is not null;

    private void ClearExactDates()
    {
        _fromDate = null;
        _toDate = null;
    }

    private static DateOnly? ParseDate(string? value) =>
        DateOnly.TryParse(value, System.Globalization.CultureInfo.InvariantCulture,
            System.Globalization.DateTimeStyles.None, out var d) ? d : null;

    /// <summary>Maps the selected sources to Tavily include-domains. Empty = search the whole web.</summary>
    private IReadOnlyList<string> SelectedDomains()
    {
        if (_selectedSources.Count == 0 || _selectedSources.Contains(AnywhereSource))
            return Array.Empty<string>();

        return _selectedSources
            .Select(s => SourceOptions.GetValueOrDefault(s, string.Empty))
            .Where(d => !string.IsNullOrEmpty(d))
            .ToArray();
    }

    /// <summary>Composes the structured inputs into a clear preferences block the Coordinator parses.</summary>
    private string BuildPreferences()
    {
        var lines = new List<string>();

        if (_selectedRoles.Count > 0)
            lines.Add($"Target roles: {string.Join(", ", RoleOptions.Where(_selectedRoles.Contains))}");
        if (_selectedLanguages.Count > 0)
            lines.Add($"Languages / tech: {string.Join(", ", LanguageOptions.Where(_selectedLanguages.Contains))}");
        if (_workingStyles.Count > 0)
        {
            // Preserve the canonical Onsite/Hybrid/Remote ordering.
            var styles = WorkingStyleOptions.Where(_workingStyles.Contains);
            lines.Add($"Working style: {string.Join(", ", styles)}");
        }
        if (!string.IsNullOrWhiteSpace(EffectiveLocation))
            lines.Add($"Location: {EffectiveLocation}");

        if (_salaryMin is not null || _salaryMax is not null)
        {
            var range = (_salaryMin, _salaryMax) switch
            {
                ({ } min, { } max) => $"{min:N0} - {max:N0}",
                ({ } min, null) => $"from {min:N0}",
                (null, { } max) => $"up to {max:N0}",
                _ => string.Empty,
            };
            lines.Add($"Expected salary: {range} {_currency} per year");
        }

        if (_selectedSources.Count > 0)
            lines.Add($"Preferred job sites: {string.Join(", ", _selectedSources)}");
        if (!string.IsNullOrWhiteSpace(_otherPreferences))
            lines.Add($"Other preferences: {_otherPreferences.Trim()}");

        return string.Join('\n', lines);
    }

    /// <summary>
    /// Parses the resume + preferences into criteria and surfaces the must-have / nice-to-have skills
    /// and work modes for the user to review and edit before launching the search.
    /// </summary>
    private async Task AnalyzeAsync()
    {
        if (_analyzing || _running || string.IsNullOrWhiteSpace(_resume))
            return;

        _analyzing = true;
        _error = null;
        try
        {
            var criteria = await JobHunt.AnalyzeAsync(_resume, BuildPreferences(), null, CancellationToken.None);
            _criteria = criteria;
            _mustHaveText = string.Join(", ", criteria.MustHaveSkills);
            _niceToHaveText = string.Join(", ", criteria.NiceToHaveSkills);

            _editWorkStyles.Clear();
            foreach (var style in criteria.WorkStyles)
                _editWorkStyles.Add(style);
            // Fall back to the form's work-mode selection if the model inferred none.
            if (_editWorkStyles.Count == 0)
                foreach (var style in WorkingStyleOptions.Where(_workingStyles.Contains))
                    _editWorkStyles.Add(style);
        }
        catch (Exception ex)
        {
            _error = $"Couldn't analyze criteria: {ex.Message}";
        }
        finally
        {
            _analyzing = false;
        }
    }

    private void ToggleEditWorkStyle(string style, bool selected)
    {
        if (selected)
            _editWorkStyles.Add(style);
        else
            _editWorkStyles.Remove(style);
    }

    private static string[] SplitCsv(string text) =>
        text.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

    // Fresh search from the form: reset any "Search harder" escalation, then run.
    private async Task StartAsync()
    {
        _searchBoost = 0;
        await RunHuntAsync();
    }

    // Re-run the same search with a bigger budget (more searches + more results), replacing results.
    private async Task SearchHarderAsync()
    {
        _searchBoost++;
        await RunHuntAsync();
    }

    private async Task RunHuntAsync()
    {
        if (_running)
            return;

        _running = true;
        _error = null;
        _tavilyRequests = 0;
        _searchTavily = 0;
        _researchTavily = 0;
        _searchCost = 0m;
        _matchCost = 0m;
        _otherCost = 0m;
        _result = null;
        _dossiers = new();
        _researchingCompany.Clear();
        _researchingSalary.Clear();
        _researchingInterview.Clear();
        _visibleCount = PageSize;
        _activity.Clear();
        _streaming.Clear();
        _cts = new CancellationTokenSource();

        _lastInputs = CurrentInputs();
        _lastTitle = BuildTitle(_lastInputs);
        _lastPreferences = BuildPreferences();

        // Remember the CV for next time (best-effort).
        try
        {
            await Profile.SaveAsync(_resume);
            _savedCvExists = true;
        }
        catch
        {
            // Non-fatal: a failed save shouldn't block the hunt.
        }

        var domains = SelectedDomains();
        // "Search harder" escalates the budget each click: more searches AND a higher result target.
        var maxSearches = _searchEffort + 4 * _searchBoost;
        var baseResults = JobHuntConfig.Default.MaxResults + 6 * _searchBoost;
        // Give each selected site room to contribute: scale the target up with the number of sources.
        var maxResults = domains.Count > 1
            ? Math.Min(30, baseResults + 3 * (domains.Count - 1))
            : baseResults;
        _lastMinScore = _minMatchScore;
        // Per-agent model overrides chosen in the sidebar (null fields fall back to the app default).
        var models = await ModelConfig.LoadAsync() ?? new AgentModelConfig();
        var config = JobHuntConfig.Default with
        {
            CoordinatorModel = models.CoordinatorModel,
            SearchModel = models.SearchModel,
            ResumeMatchModel = models.ResumeMatchModel,
            CompanyResearchModel = models.CompanyResearchModel,
            SalaryAnalysisModel = models.SalaryAnalysisModel,
            InterviewPrepModel = models.InterviewPrepModel,
            IncludeDomains = domains,
            MaxResults = maxResults,
            MaxSearches = maxSearches,
            // Parallel search (Settings): research 2 matches at once, or 1-by-1 when off.
            MaxFanOutConcurrency = models.ParallelSearch ? 2 : 1,
            // Per-call Tavily search-depth policy (Settings).
            SearchDepth = models.SearchDepth ?? SearchDepthSettings.Default,
            // Input-truncation caps (Settings): 0 = no cap.
            MaxResumeChars = models.MaxResumeChars,
            MaxDescriptionChars = models.MaxDescriptionChars,
            MaxSearchResultChars = models.MaxSearchResultChars,
            MinMatchScore = _minMatchScore,
            ResearchCompany = _researchCompany,
            ResearchSalary = _researchSalary,
            TimeRange = string.IsNullOrEmpty(_postedWithin) ? null : _postedWithin,
            StartDate = _fromDate?.ToString("yyyy-MM-dd"),
            EndDate = _toDate?.ToString("yyyy-MM-dd"),
        };

        // If the user reviewed/edited the parsed criteria, run with their edits (skips re-parsing).
        // Captured in CurrentInputs() above so it's also persisted with the run.
        var overrideCriteria = _lastInputs.Criteria;

        try
        {
            var (_, events) = JobHunt.Start(_resume, _lastPreferences, config, overrideCriteria, _cts.Token);

            await foreach (var evt in events.WithCancellation(_cts.Token))
            {
                Handle(evt);

                if (evt is AgentFinishedEvent finished && finished.AgentId == AgentId.System)
                {
                    _result = TryParseResult(finished.FinalText);
                    _dossiers = _result?.Dossiers.ToList() ?? new();
                    await PersistAsync(finished);
                }
                else if (evt is AgentErrorEvent error && error.AgentId == AgentId.System)
                {
                    _error = error.Message;
                }

                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
            // Navigated away / cancelled.
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _running = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void Handle(AgentEvent evt)
    {
        switch (evt)
        {
            case AgentStartedEvent e:
                var item = new ActivityItem("▶️", $"{e.Role} started", string.Empty);
                _streaming[e.AgentId.Value] = item;
                _activity.Add(item);
                break;

            case AgentTokenEvent e when _streaming.TryGetValue(e.AgentId.Value, out var streaming):
                streaming.Detail += e.Delta;
                break;

            case AgentFinishedEvent e when e.AgentId != AgentId.System:
                if (_streaming.TryGetValue(e.AgentId.Value, out var done))
                    done.Icon = "✅";
                // Bucket the per-agent cost: search agent, resume matcher (Claude), or everything else.
                var spent = e.EstimatedCostUsd ?? 0m;
                if (e.AgentId == AgentId.Search)
                    _searchCost += spent;
                else if (e.AgentId.Value.StartsWith("resume-match", StringComparison.Ordinal))
                    _matchCost += spent;
                else
                    _otherCost += spent;
                break;

            case ToolCalledEvent e:
                _activity.Add(new ActivityItem("🔧", e.ToolName, Truncate(e.ArgumentsJson, 140)));
                break;

            case WebSearchRequestedEvent e:
                _tavilyRequests++;
                if (e.AgentId == AgentId.Search)
                    _searchTavily++;
                else
                    _researchTavily++;
                _activity.Add(new ActivityItem("🌐",
                    $"Web search #{_tavilyRequests}{(e.IsFallback ? " (fallback)" : "")}", Truncate(e.Query, 140)));
                break;

            case JobsFoundEvent e:
                var bySource = e.Postings
                    .GroupBy(p => SourceHost(p.Url))
                    .OrderByDescending(g => g.Count())
                    .Select(g => $"{g.Key}: {g.Count()}");
                _activity.Add(new ActivityItem(
                    "🔎", $"Found {e.Postings.Count} postings", string.Join(" · ", bySource)));
                break;

            case JobMatchedEvent e:
                _activity.Add(new ActivityItem("📋",
                    $"{e.Match.Posting.Title} @ {e.Match.Posting.Company}", $"Fit {e.Match.Score}/100"));
                break;

            case CompanyResearchedEvent e:
                _activity.Add(new ActivityItem("🏢", $"Researched {e.Insight.Company}", string.Empty));
                break;

            case SalaryAnalyzedEvent e:
                _activity.Add(new ActivityItem("💰", "Salary analysed", e.Estimate.Basis));
                break;

            case InterviewPrepReadyEvent e:
                _activity.Add(new ActivityItem("🎤",
                    $"Interview prep ready ({e.Prep.LikelyQuestions.Count} questions)", string.Empty));
                break;
        }
    }

    private async Task PersistAsync(AgentFinishedEvent finished)
    {
        if (_result is null)
            return;

        _lastRunId = finished.RunId.Value;
        var run = new PersistedRun(
            finished.RunId.Value, DateTime.UtcNow, _lastTitle, _lastPreferences,
            _lastInputs, TotalCost, _result);
        try
        {
            await Store.SaveAsync(run);
            await RefreshRecentAsync();
        }
        catch
        {
            // Persistence is best-effort; don't fail the run on a write error.
        }
    }

    /// <summary>
    /// Persists a human score for one match as a <see cref="MatchFeedback"/> record. Captures the resume
    /// and criteria that were actually in scope for this run, so the eval can replay it as a calibration
    /// case (the matcher's own score is kept alongside for comparison).
    /// </summary>
    private async Task SaveFeedbackAsync(JobDossier dossier, DossierCard.ScoreSubmission submission)
    {
        if (_result is null || string.IsNullOrWhiteSpace(_resume))
            return;

        var feedback = new MatchFeedback(
            RunId: _lastRunId ?? string.Empty,
            CreatedAtUtc: DateTime.UtcNow,
            Resume: _resume,
            Posting: dossier.Match.Posting,
            Criteria: _result.Criteria,
            AgentScore: dossier.Match.Score,
            AgentMatchedSkills: dossier.Match.MatchedSkills,
            HumanScore: submission.Score,
            Note: submission.Note);

        try
        {
            await Feedback.SaveAsync(feedback);
        }
        catch
        {
            // Feedback capture is best-effort; never break the results view over a write error.
        }
    }

    private static JobHuntResult? TryParseResult(string json)
    {
        try
        {
            return JsonSerializer.Deserialize<JobHuntResult>(json, JsonOptions);
        }
        catch (JsonException)
        {
            return null;
        }
    }

    private static string Truncate(string value, int max) =>
        value.Length <= max ? value : value[..max] + "…";

    private static string SourceHost(string? url) => SourceHostUtil.From(url);

    private static string DossierKey(JobDossier d) =>
        string.IsNullOrWhiteSpace(d.Match.Posting.Url)
            ? $"{d.Match.Posting.Title}|{d.Match.Posting.Company}"
            : d.Match.Posting.Url;

    private Task ResearchCompanyAsync(JobDossier dossier) => ResearchPieceAsync(
        dossier, _researchingCompany, "company",
        async () => await Expander.ResearchCompanyAsync(dossier.Match, JobHuntConfig.Default),
        (d, r) => d with { Company = r });

    private Task ResearchSalaryAsync(JobDossier dossier) => ResearchPieceAsync(
        dossier, _researchingSalary, "salary",
        async () => await Expander.ResearchSalaryAsync(dossier.Match, _result!.Criteria, JobHuntConfig.Default),
        (d, r) => d with { Salary = r });

    private Task ResearchInterviewAsync(JobDossier dossier) => ResearchPieceAsync(
        dossier, _researchingInterview, "interview prep",
        async () => await Expander.ResearchInterviewAsync(dossier.Match, JobHuntConfig.Default),
        (d, r) => d with { Interview = r });

    /// <summary>
    /// Runs one on-demand specialist for a single card: guards against double-clicks via
    /// <paramref name="inFlight"/>, then merges the result back into the dossier with <paramref name="merge"/>.
    /// </summary>
    private async Task ResearchPieceAsync<T>(
        JobDossier dossier, HashSet<string> inFlight, string label,
        Func<Task<T>> research, Func<JobDossier, T, JobDossier> merge)
    {
        if (_result is null)
            return;

        var key = DossierKey(dossier);
        if (!inFlight.Add(key))
            return; // already in progress

        await InvokeAsync(StateHasChanged);
        try
        {
            var result = await research();
            var index = _dossiers.FindIndex(d => DossierKey(d) == key);
            if (index >= 0)
                _dossiers[index] = merge(_dossiers[index], result);
        }
        catch (Exception ex)
        {
            _error = $"Couldn't research {label} for that role: {ex.Message}";
        }
        finally
        {
            inFlight.Remove(key);
            await InvokeAsync(StateHasChanged);
        }
    }

    public void Dispose() => _cts?.Cancel();

    private sealed class ActivityItem(string icon, string title, string detail)
    {
        public string Icon { get; set; } = icon;
        public string Title { get; set; } = title;
        public string Detail { get; set; } = detail;
    }
}
