        else
            _selectedRoles.Remove(role);
    }

    private void ToggleLanguage(string lang, bool selected)
    {
        if (selected)
            _selectedLanguages.Add(lang);
        else
            _selectedLanguages.Remove(lang);
    }

    private void ToggleWorkingStyle(string style, bool selected)
    {
        if (selected)
            _workingStyles.Add(style);
        else
            _workingStyles.Remove(style);
