@page "/"
@rendermode InteractiveServer
@using System.Text.Json
@implements IDisposable
@inject StartJobHuntUseCase JobHunt
@inject RunStore Store
@inject FeedbackStore Feedback
@inject ResumeTextExtractor ResumeExtractor
@inject ProfileStore Profile
@inject ModelConfigStore ModelConfig
@inject IMatchExpander Expander

<PageTitle>JobAgents</PageTitle>

<h1>Job Hunt</h1>
<p class="text-muted">
    Paste your resume and what you're after. A coordinator agent sources live jobs, matches them to
    you, then researches the company, salary, and interview prep for your best matches.
</p>

<div class="row g-4">
    <div class="col-12 search-pane">
        @{
            var pinned = _recent.Where(r => r.Pinned && r.Inputs is not null).ToList();
        }
        @if (pinned.Count > 0)
        {
            <div class="mb-3">
                <label class="form-label fw-bold">⭐ Pinned searches</label>
                <div class="d-flex flex-wrap gap-2">
                    @foreach (var run in pinned)
                    {
                        <button type="button" class="btn btn-sm btn-outline-warning"
                                @onclick="() => ApplyPinned(run)" title="Load this search">
                            @run.Title
                        </button>
                    }
                </div>
            </div>
        }

        @if (_recent.Count > 0)
        {
            <div class="mb-3">
                <label class="form-label fw-bold">Continue a previous search</label>
                <select class="form-select" @onchange="OnRecentSelected">
                    <option value="">— start fresh —</option>
                    @foreach (var run in _recent)
                    {
                        <option value="@run.RunId">@(run.Pinned ? "★ " : "")@run.Title (@run.CompletedAtUtc.ToString("MM-dd HH:mm"))</option>
                    }
                </select>
                @if (_recentStatus is not null)
                {
                    <div class="small text-muted mt-1">@_recentStatus</div>
                }
            </div>
        }

        <EditForm Model="this" OnValidSubmit="StartAsync">
            <div class="mb-3">
                <label class="form-label fw-bold d-block">Resume</label>
                <div class="btn-group btn-group-sm mb-2" role="group">
                    <button type="button"
                            class="btn @(_resumeMode == ResumeInput.Paste ? "btn-primary" : "btn-outline-primary")"
                            @onclick="() => _resumeMode = ResumeInput.Paste">
                        Paste text
                    </button>
                    <button type="button"
                            class="btn @(_resumeMode == ResumeInput.Upload ? "btn-primary" : "btn-outline-primary")"
                            @onclick="() => _resumeMode = ResumeInput.Upload">
                        Upload file
                    </button>
                </div>

                @if (_resumeMode == ResumeInput.Paste)
                {
                    <textarea class="form-control" rows="10" @bind="_resume"
                              placeholder="Paste your resume text here..."></textarea>
                }
                else
                {
                    <InputFile class="form-control" accept=".txt,.md,.pdf,.docx" OnChange="OnFileSelectedAsync" />
                    <div class="form-text">Supported: PDF, Word (.docx), or plain text (.txt, .md). Max 5&nbsp;MB.</div>
                    @if (_uploadStatus is not null)
                    {
                        <div class="small mt-1 @(_uploadFailed ? "text-danger" : "text-success")">@_uploadStatus</div>
                    }
                    @if (!string.IsNullOrWhiteSpace(_resume))
                    {
                        @if (_editingUpload)
                        {
                            <textarea class="form-control mt-2" rows="12" @bind="_resume" @bind:event="oninput"></textarea>
                            <button type="button" class="btn btn-sm btn-outline-secondary mt-1"
                                    @onclick="() => _editingUpload = false">Done editing</button>
                        }
                        else
                        {
                            <div class="border rounded p-2 mt-2 bg-light resume-preview"
                                 style="max-height: 300px; overflow-y: auto; white-space: pre-wrap; word-break: break-word; font-size: 0.85rem;">@_resume</div>
                            <div class="d-flex justify-content-between">
                                <span class="form-text">Extracted text preview.</span>
                                <button type="button" class="btn btn-sm btn-link p-0"
                                        @onclick="() => _editingUpload = true">Edit extracted text</button>
                            </div>
                        }
                    }
                }

                <div class="mt-2 d-flex align-items-center gap-2 flex-wrap">
                    <button type="button" class="btn btn-sm btn-outline-secondary"
                            @onclick="SaveCvAsync" disabled="@string.IsNullOrWhiteSpace(_resume)">
                        💾 Save CV
                    </button>
                    @if (_savedCvExists)
                    {
                        <button type="button" class="btn btn-sm btn-outline-danger" @onclick="ForgetCvAsync">
                            🗑 Forget saved CV
                        </button>
                    }
                    @if (_profileStatus is not null)
                    {
                        <span class="small text-muted">@_profileStatus</span>
                    }
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label fw-bold d-block">Preferences</label>

                <div class="row g-2">
                    <div class="col-sm-6">
                        <label class="form-label small mb-0 d-flex justify-content-between">
                            <span>Roles <span class="text-muted">(pick any)</span></span>
                            <span>
                                <a role="button" class="link-secondary me-2" @onclick="() => SetAllRoles(true)">all</a>
                                <a role="button" class="link-secondary" @onclick="() => SetAllRoles(false)">clear</a>
                            </span>
                        </label>
                        <div class="border rounded p-2" style="max-height: 150px; overflow-y: auto;">
                            @foreach (var role in RoleOptions)
                            {
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="role-@role"
                                           checked="@_selectedRoles.Contains(role)"
                                           @onchange="e => ToggleRole(role, (bool)e.Value!)" />
                                    <label class="form-check-label" for="role-@role">@role</label>
                                </div>
                            }
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <label class="form-label small mb-0 d-flex justify-content-between">
                            <span>Languages / tech <span class="text-muted">(pick any)</span></span>
                            <span>
                                <a role="button" class="link-secondary me-2" @onclick="() => SetAllLanguages(true)">all</a>
                                <a role="button" class="link-secondary" @onclick="() => SetAllLanguages(false)">clear</a>
                            </span>
                        </label>
                        <div class="border rounded p-2" style="max-height: 150px; overflow-y: auto;">
                            @foreach (var lang in LanguageOptions)
                            {
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="lang-@lang"
                                           checked="@_selectedLanguages.Contains(lang)"
                                           @onchange="e => ToggleLanguage(lang, (bool)e.Value!)" />
                                    <label class="form-check-label" for="lang-@lang">@lang</label>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <div class="mt-2">
                    <label class="form-label small mb-0 d-block">Working style</label>
                    @foreach (var style in WorkingStyleOptions)
                    {
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="checkbox" id="ws-@style"
                                   checked="@_workingStyles.Contains(style)"
                                   @onchange="e => ToggleWorkingStyle(style, (bool)e.Value!)" />
                            <label class="form-check-label" for="ws-@style">@style</label>
                        </div>
                    }
                </div>

                <div class="mt-2">
                    <label class="form-label small mb-0 d-block">
                        Sources <span class="text-muted">(which sites to scan — none = whole web)</span>
                    </label>
                    @foreach (var source in SourceOptions.Keys)
                    {
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="checkbox" id="src-@source"
                                   checked="@_selectedSources.Contains(source)"
                                   @onchange="e => ToggleSource(source, (bool)e.Value!)" />
                            <label class="form-check-label" for="src-@source">@source</label>
                        </div>
                    }
                </div>

                <div class="row g-2 mt-1 align-items-end">
                    <div class="col-sm-4">
                        <label class="form-label small mb-0">Location</label>
                        <select class="form-select" @bind="_location" disabled="@(!string.IsNullOrWhiteSpace(_customLocation))">
                            <option value="">Anywhere</option>
                            <option value="Remote">Remote</option>
                            @foreach (var city in CityOptions)
                            {
                                <option value="@city">@city</option>
                            }
                        </select>
                        <input class="form-control form-control-sm mt-1" @bind="_customLocation" @bind:event="oninput"
                               placeholder="or type a custom location" />
                    </div>
                    <div class="col-sm-5">
                        <label class="form-label small mb-0">Expected salary range</label>
                        <div class="input-group">
                            <input type="number" class="form-control" @bind="_salaryMin" placeholder="min" min="0" />
                            <span class="input-group-text">–</span>
                            <input type="number" class="form-control" @bind="_salaryMax" placeholder="max" min="0" />
                        </div>
                    </div>
                    <div class="col-sm-3">
                        <label class="form-label small mb-0">Currency</label>
                        <select class="form-select" @bind="_currency">
                            @foreach (var c in CurrencyOptions)
                            {
                                <option value="@c">@c</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="row g-2 mt-1 align-items-end">
                    <div class="col-sm-4">
                        <label class="form-label small mb-0">Posted within</label>
                        <select class="form-select" @bind="_postedWithin" disabled="@HasExactDates">
                            @foreach (var option in PostedWithinOptions)
                            {
                                <option value="@option.Value">@option.Key</option>
                            }
                        </select>
                    </div>
                    <div class="col-sm-8">
                        <label class="form-label small mb-0">Or exact dates <span class="text-muted">(overrides the above)</span></label>
                        <div class="input-group">
                            <input type="date" class="form-control" @bind="_fromDate" aria-label="From" />
                            <span class="input-group-text">→</span>
                            <input type="date" class="form-control" @bind="_toDate" aria-label="To" />
                            @if (HasExactDates)
                            {
                                <button class="btn btn-outline-secondary" type="button" @onclick="ClearExactDates">Clear</button>
                            }
                        </div>
                    </div>
                </div>

                <div class="mt-2">
                    <label class="form-label small mb-0">
                        Minimum fit score: <strong>@_minMatchScore</strong>/100
                        <span class="text-muted">(only show matches at or above this)</span>
                    </label>
                    <input type="range" class="form-range" min="0" max="100" step="5"
                           @bind="_minMatchScore" @bind:event="oninput" />
                </div>

                <div class="mt-2">
                    <label class="form-label small mb-0 d-block">
                        Search effort <span class="text-muted">(how many web searches to run)</span>
                    </label>
                    @foreach (var (label, value, hint) in SearchEffortOptions)
                    {
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="searchEffort"
                                   id="@($"effort-{value}")"
                                   checked="@(_searchEffort == value)"
                                   @onchange="() => _searchEffort = value" />
                            <label class="form-check-label small" for="@($"effort-{value}")">@label <span class="text-muted">@hint</span></label>
                        </div>
                    }
                </div>

                <div class="mt-2">
                    <label class="form-label small mb-0">Anything else <span class="text-muted">(optional)</span></label>
                    <textarea class="form-control" rows="2" @bind="_otherPreferences"
                              placeholder="e.g. fintech or health domains, no on-call, visa sponsorship"></textarea>
                </div>
            </div>
            <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                <button type="button" class="btn btn-outline-primary"
                        @onclick="AnalyzeAsync"
                        disabled="@(_running || _analyzing || string.IsNullOrWhiteSpace(_resume))">
                    @if (_analyzing)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                        <span>Analyzing…</span>
                    }
                    else
                    {
                        <span>Analyze criteria</span>
                    }
                </button>
                <span class="text-muted small">Optional — review the inferred skills &amp; work modes before searching.</span>
            </div>

            @if (_criteria is not null)
            {
                <div class="card border-primary mb-3">
                    <div class="card-body py-2">
                        <h6 class="card-title mb-2">Review &amp; edit criteria</h6>
                        <div class="mb-2">
                            <label class="form-label small mb-0">Must-have skills <span class="text-muted">(comma-separated)</span></label>
                            <input class="form-control form-control-sm" @bind="_mustHaveText"
                                   placeholder="e.g. C#, .NET, Kafka, AWS" />
                        </div>
                        <div class="mb-2">
                            <label class="form-label small mb-0">Nice-to-have skills <span class="text-muted">(comma-separated)</span></label>
                            <input class="form-control form-control-sm" @bind="_niceToHaveText"
                                   placeholder="e.g. GraphQL, Terraform" />
                        </div>
                        <div>
                            <label class="form-label small mb-0 d-block">Work mode</label>
                            @foreach (var style in WorkingStyleOptions)
                            {
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="checkbox" id="@($"wm-{style}")"
                                           checked="@_editWorkStyles.Contains(style)"
                                           @onchange="e => ToggleEditWorkStyle(style, (bool)e.Value!)" />
                                    <label class="form-check-label" for="@($"wm-{style}")">@style</label>
                                </div>
                            }
                        </div>
                        <div class="form-text">Searching uses these criteria. Change the form above and Analyze again to refresh.</div>
                    </div>
                </div>
            }

            <div class="mb-3">
                <label class="form-label small mb-1 d-block">
                    Extra research <span class="text-muted">(off by default — each adds web searches; turn on to include)</span>
                </label>
                <div class="btn-group btn-group-sm" role="group">
                    <button type="button"
                            class="btn @(_researchCompany ? "btn-primary" : "btn-outline-primary")"
                            @onclick="() => _researchCompany = !_researchCompany">
                        🏢 Company research: @(_researchCompany ? "on" : "off")
                    </button>
                    <button type="button"
                            class="btn @(_researchSalary ? "btn-primary" : "btn-outline-primary")"
                            @onclick="() => _researchSalary = !_researchSalary">
                        💰 Salary research: @(_researchSalary ? "on" : "off")
                    </button>
                </div>
            </div>

            <button type="submit" class="btn btn-primary" disabled="@(_running || string.IsNullOrWhiteSpace(_resume))">
                @if (_running)
                {
                    <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                    <span>Hunting…</span>
                }
                else
                {
                    <span>@(_criteria is not null ? "Search with these" : "Find jobs")</span>
                }
            </button>
            @if (_result is not null && !_running)
            {
                <button type="button" class="btn btn-outline-secondary btn-sm ms-3"
                        @onclick="SearchHarderAsync" disabled="@string.IsNullOrWhiteSpace(_resume)"
                        title="Re-run with a bigger search budget and more results">
                    🔁 Search harder
                </button>
            }
        </EditForm>

        @if (_error is not null)
        {
            <div class="alert alert-danger mt-3">@_error</div>
        }

        <h5 class="mt-4">Activity</h5>
        <div class="activity-log border rounded p-2" style="max-height: 460px; overflow-y: auto;">
            @if (_activity.Count == 0)
            {
                <span class="text-muted">No activity yet.</span>
            }
            @foreach (var item in _activity)
            {
                <div class="activity-item small mb-1">
                    <span>@item.Icon</span>
                    <strong>@item.Title</strong>
                    @if (!string.IsNullOrWhiteSpace(item.Detail))
                    {
                        <div class="text-muted ms-3">@item.Detail</div>
                    }
                </div>
            }
        </div>
    </div>

    <div class="col-12 result-pane">
        <h5>Results</h5>

        @if (_running || _result is not null)
        {
            <div class="card mb-3 cost-summary">
                <div class="card-body py-2">
                    <div class="d-flex flex-wrap gap-3 align-items-center small">
                        <span class="badge bg-secondary fs-6">
                            Total: @TotalCost.ToString("$0.0000")
                        </span>
                        <span title="Resume-matching LLM cost (Claude)">
                            🧩 Matching (Claude): <strong>@_matchCost.ToString("$0.0000")</strong>
                        </span>
                        <span title="Job-search agent LLM cost (OpenAI)">
                            🔎 Search (OpenAI): <strong>@_searchCost.ToString("$0.0000")</strong>
                        </span>
                        @if (_otherCost > 0m)
                        {
                            <span title="Coordinator, company/salary/interview research (OpenAI)">
                                📊 Research &amp; synthesis: <strong>@_otherCost.ToString("$0.0000")</strong>
                            </span>
                        }
                        <span title="Tavily web-search requests this run (incl. fallbacks): job sourcing vs. company research">
                            🌐 Tavily: <strong>@_tavilyRequests</strong>
                            <span class="text-muted">(🔎 search @_searchTavily · 🏢 research @_researchTavily)</span>
                        </span>
                    </div>
                </div>
            </div>
        }

        @if (_result is null)
        {
            <p class="text-muted">Ranked job dossiers will appear here when the run finishes.</p>
        }
        else
        {
            <div class="alert alert-info">@_result.Summary</div>
            <p class="text-muted small">
                @_dossiers.Count match@(_dossiers.Count == 1 ? "" : "es") scoring ≥ @_lastMinScore/100.
                Company, salary &amp; interview prep are researched for the top matches; expand any other
                card to research it on demand.
            </p>
            @foreach (var dossier in _dossiers.Take(_visibleCount))
            {
                var key = DossierKey(dossier);
                <DossierCard Dossier="dossier"
                             OnResearchCompany="() => ResearchCompanyAsync(dossier)"
                             OnResearchSalary="() => ResearchSalaryAsync(dossier)"
                             OnResearchInterview="() => ResearchInterviewAsync(dossier)"
                             ResearchingCompany="_researchingCompany.Contains(key)"
                             ResearchingSalary="_researchingSalary.Contains(key)"
                             ResearchingInterview="_researchingInterview.Contains(key)"
                             EnableFeedback="true"
                             OnSubmitScore="s => SaveFeedbackAsync(dossier, s)" />
            }
            @if (_dossiers.Count > _visibleCount)
            {
                <button class="btn btn-outline-primary w-100"
                        @onclick="() => _visibleCount += PageSize">
                    Load more (@(_dossiers.Count - _visibleCount) remaining)
                </button>
            }
        }
    </div>
</div>

@code {
    private enum ResumeInput { Paste, Upload }

    private const long MaxUploadBytes = 5 * 1024 * 1024;

    private static readonly string[] RoleOptions =
    [
        "Backend Engineer", "Frontend Engineer", "Full-stack Engineer",
        "Senior Backend Engineer", "Senior Frontend Engineer", "Senior Full-stack Engineer",
        "Staff Engineer", "Tech Lead", "Engineering Manager",
        "DevOps / SRE", "Data Engineer", "Machine Learning Engineer",
    ];

    private static readonly string[] LanguageOptions =
    [
        "C#", "Python", "JavaScript", "TypeScript", "Java", "Go", "Rust", "C++", "Ruby", "PHP", "Kotlin", "Swift",
    ];

    private static readonly string[] WorkingStyleOptions = ["Onsite", "Hybrid", "Remote"];
    private static readonly string[] CurrencyOptions = ["USD", "GBP", "EUR", "AUD", "NZD", "CAD", "VND"];

    // Label → Tavily time_range value ("" = any time).
    private static readonly Dictionary<string, string> PostedWithinOptions = new()
    {
        ["Any time"] = "",
        ["Past week"] = "week",
        ["Past month"] = "month",
        ["Past year"] = "year",
    };

    // Major hiring hubs worldwide; Ho Chi Minh City is the default selection.
    private static readonly string[] CityOptions =
    [
        "Ho Chi Minh City", "Hanoi", "Da Nang",
        "Singapore", "Bangkok", "Kuala Lumpur", "Jakarta", "Manila",
        "Tokyo", "Seoul", "Hong Kong", "Shanghai", "Beijing", "Taipei",
        "Bangalore", "Mumbai", "Hyderabad", "Sydney", "Melbourne", "Auckland",
        "London", "Dublin", "Berlin", "Munich", "Amsterdam", "Paris", "Madrid",
        "Barcelona", "Lisbon", "Zurich", "Stockholm", "Warsaw",
        "Dubai", "Tel Aviv",
        "New York", "San Francisco", "Seattle", "Austin", "Boston", "Los Angeles", "Chicago",
        "Toronto", "Vancouver",
    ];

    private const string AnywhereSource = "Anywhere (web)";

    // Source label → domain to restrict Tavily to. "Anywhere" (and the empty selection) means no filter.
    private static readonly Dictionary<string, string> SourceOptions = new()
    {
        ["ITviec"] = "itviec.com",
        ["VietnamWorks"] = "vietnamworks.com",
        ["LinkedIn"] = "linkedin.com",
        ["TopCV"] = "topcv.vn",
        [AnywhereSource] = "",
    };

    private string _resume = string.Empty;
    private ResumeInput _resumeMode = ResumeInput.Paste;
    private string? _uploadStatus;
    private bool _uploadFailed;
    private bool _editingUpload;
    private bool _savedCvExists;
    private string? _profileStatus;
    private bool _running;

    // Two-step "Analyze → review/edit criteria → Search" state.
    private bool _analyzing;
    private SearchCriteria? _criteria;
    private string _mustHaveText = string.Empty;
    private string _niceToHaveText = string.Empty;
    private readonly HashSet<string> _editWorkStyles = new();

    // Structured preferences.
    private readonly HashSet<string> _selectedRoles = new();
    private readonly HashSet<string> _selectedLanguages = new();
    private readonly HashSet<string> _workingStyles = new();
    private string _location = "Ho Chi Minh City";
    private string _customLocation = string.Empty;
    private DateOnly? _fromDate;
    private DateOnly? _toDate;
    private int? _salaryMin;
    private int? _salaryMax;
    private string _currency = "USD";
    private string _otherPreferences = string.Empty;
    private readonly HashSet<string> _selectedSources = new();
    private int _minMatchScore = 60;
    private int _lastMinScore = 60;
    // Opt-in extra research, OFF by default to save Tavily calls; user toggles each on per run.
    private bool _researchCompany;
    private bool _researchSalary;
    private string _postedWithin = "month"; // default to the last month to avoid stale results
    private string _lastPreferences = string.Empty;
    private SearchInputs _lastInputs = SearchInputs.Empty;
    private string _lastTitle = string.Empty;
    // The id of the most recent finished run, so feedback can be attributed to it.
    private string? _lastRunId;

    private List<PersistedRun> _recent = new();
    private string? _recentStatus;
    private bool _pendingAutoRun;

    [SupplyParameterFromQuery(Name = "continue")]
    public string? ContinueRunId { get; set; }

    [SupplyParameterFromQuery(Name = "run")]
    public bool AutoRun { get; set; }

    private string? _error;
    private int _tavilyRequests;
    // Tavily requests split by the agent that issued them: the Search agent (job sourcing) vs. the
    // Company-Research agent (looking up top matches). _tavilyRequests is the run-wide total.
    private int _searchTavily;
    private int _researchTavily;
    // Per-category LLM cost, accumulated from each agent's finished event (the matcher runs on Claude,
    // everything else on OpenAI, so the split is genuinely useful).
    private decimal _searchCost;
    private decimal _matchCost;
    private decimal _otherCost;
    // True run cost = sum of every agent's reported cost off the bus. The Coordinator's System-event
    // aggregate only covers its own parse/synthesis calls, so we total the per-agent costs ourselves
    // (same approach the eval uses) rather than trust finished.EstimatedCostUsd.
    private decimal TotalCost => _searchCost + _matchCost + _otherCost;
    private JobHuntResult? _result;

    // Search budget: user-selected effort (max searches) + an escalation applied by "Search harder".
    private static readonly (string Label, int Value, string Hint)[] SearchEffortOptions =
        [("Light", 4, "(4)"), ("Normal", 6, "(6)"), ("Deep", 10, "(10)")];
    private int _searchEffort = 6;
    private int _searchBoost;

    private const int PageSize = 5;
    private int _visibleCount = PageSize;
    private List<JobDossier> _dossiers = new();
    // In-flight on-demand research, tracked per dossier key so each card shows its own spinner.
    private readonly HashSet<string> _researchingCompany = new();
    private readonly HashSet<string> _researchingSalary = new();
    private readonly HashSet<string> _researchingInterview = new();

    private readonly List<ActivityItem> _activity = new();
    private readonly Dictionary<string, ActivityItem> _streaming = new();
    private CancellationTokenSource? _cts;

    private static readonly JsonSerializerOptions JsonOptions = new(JsonSerializerDefaults.Web);

    private async Task OnFileSelectedAsync(InputFileChangeEventArgs e)
    {
        _editingUpload = false;
        var file = e.File;
        if (!ResumeExtractor.IsSupported(file.Name))
        {
            _uploadFailed = true;
            _uploadStatus = $"Unsupported file type. Use {string.Join(", ", ResumeTextExtractor.SupportedExtensions)}.";
            return;
        }

        try
        {
            using var buffer = new MemoryStream();
            await file.OpenReadStream(MaxUploadBytes).CopyToAsync(buffer);
            buffer.Position = 0;

            _resume = ResumeExtractor.Extract(file.Name, buffer);
            if (string.IsNullOrWhiteSpace(_resume))
            {
                _uploadFailed = true;
                _uploadStatus = $"No text could be extracted from {file.Name}.";
            }
            else
            {
                _uploadFailed = false;
                _uploadStatus = $"Loaded {file.Name} ({_resume.Length:N0} characters).";
            }
        }
        catch (Exception ex)
        {
            _uploadFailed = true;
            _uploadStatus = $"Couldn't read {file.Name}: {ex.Message}";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var profile = await Profile.LoadAsync();
        if (profile is not null && !string.IsNullOrWhiteSpace(profile.ResumeText))
        {
            _resume = profile.ResumeText;
            _savedCvExists = true;
            _profileStatus = $"Loaded your saved CV (updated {profile.UpdatedAtUtc:yyyy-MM-dd}).";
        }

        var all = await Store.LoadAllAsync();
        _recent = all.Take(10).ToList();

        // Deep-linked "Run again" from Past Runs: pre-fill the form, and optionally auto-start.
        if (!string.IsNullOrEmpty(ContinueRunId) &&
            all.FirstOrDefault(r => r.RunId == ContinueRunId) is { Inputs: { } inputs } run)
        {
            ApplyInputs(inputs);
            _recentStatus = $"Loaded \"{run.Title}\".";
            if (AutoRun)
                _pendingAutoRun = true;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Auto-start only on the first interactive render (never during prerender), and only if we
        // have a CV to run with.
        if (firstRender && _pendingAutoRun && !_running)
        {
            _pendingAutoRun = false;
            if (string.IsNullOrWhiteSpace(_resume))
                _recentStatus = "Loaded the search — add your CV, then Find jobs.";
            else
                await StartAsync();
        }
    }

    private async Task RefreshRecentAsync() =>
        _recent = (await Store.LoadAllAsync()).Take(10).ToList();

    private void OnRecentSelected(ChangeEventArgs e)
    {
        var runId = e.Value as string;
        if (string.IsNullOrEmpty(runId))
        {
            _recentStatus = null;
            return;
        }

        var run = _recent.FirstOrDefault(r => r.RunId == runId);
        if (run?.Inputs is { } inputs)
        {
            ApplyInputs(inputs);
            _recentStatus = $"Loaded \"{run.Title}\" — tweak anything, then Find jobs.";
        }
        else
        {
            _recentStatus = "That run has no saved inputs to continue from.";
        }
    }

    private void ApplyPinned(PersistedRun run)
    {
        if (run.Inputs is { } inputs)
        {
            ApplyInputs(inputs);
            _recentStatus = $"Loaded \"{run.Title}\" — tweak anything, then Find jobs.";
        }
    }

    private void ApplyInputs(SearchInputs inputs)
    {
        _selectedRoles.Clear();
        foreach (var role in inputs.Roles ?? [])
            _selectedRoles.Add(role);
        _selectedLanguages.Clear();
        foreach (var lang in inputs.Languages ?? [])
            _selectedLanguages.Add(lang);
        _workingStyles.Clear();
        foreach (var style in inputs.WorkingStyles ?? [])
            _workingStyles.Add(style);
        // Restore into the dropdown if it's a known option, else into the custom box.
        var loc = inputs.Location ?? string.Empty;
        if (loc.Length == 0 || loc == "Remote" || CityOptions.Contains(loc))
        {
            _location = loc;
            _customLocation = string.Empty;
        }
        else
        {
            _location = string.Empty;
            _customLocation = loc;
        }
        _salaryMin = inputs.SalaryMin;
        _salaryMax = inputs.SalaryMax;
        _currency = string.IsNullOrWhiteSpace(inputs.Currency) ? "USD" : inputs.Currency;
        _otherPreferences = inputs.Other ?? string.Empty;
        _selectedSources.Clear();
        foreach (var source in inputs.Sources ?? [])
            _selectedSources.Add(source);
        _minMatchScore = Math.Clamp(inputs.MinMatchScore, 0, 100);
        _searchEffort = SearchEffortOptions.Any(o => o.Value == inputs.SearchEffort) ? inputs.SearchEffort : 6;
        _researchCompany = inputs.ResearchCompany;
        _researchSalary = inputs.ResearchSalary;
        _postedWithin = PostedWithinOptions.Values.Contains(inputs.PostedWithin ?? "") ? inputs.PostedWithin ?? "" : "month";
        _fromDate = ParseDate(inputs.StartDate);
        _toDate = ParseDate(inputs.EndDate);

        // Restore the reviewed/edited criteria panel if the previous run used one.
        _criteria = inputs.Criteria;
        _mustHaveText = inputs.Criteria is null ? string.Empty : string.Join(", ", inputs.Criteria.MustHaveSkills);
        _niceToHaveText = inputs.Criteria is null ? string.Empty : string.Join(", ", inputs.Criteria.NiceToHaveSkills);
        _editWorkStyles.Clear();
        foreach (var style in inputs.Criteria?.WorkStyles ?? [])
            _editWorkStyles.Add(style);
    }

    private SearchInputs CurrentInputs() => new(
        Roles: RoleOptions.Where(_selectedRoles.Contains).ToArray(),
        Languages: LanguageOptions.Where(_selectedLanguages.Contains).ToArray(),
        WorkingStyles: WorkingStyleOptions.Where(_workingStyles.Contains).ToArray(),
        Location: EffectiveLocation,
        SalaryMin: _salaryMin,
        SalaryMax: _salaryMax,
        Currency: _currency,
        Other: _otherPreferences.Trim(),
        Sources: SourceOptions.Keys.Where(_selectedSources.Contains).ToArray(),
        MinMatchScore: _minMatchScore,
        PostedWithin: _postedWithin,
        StartDate: _fromDate?.ToString("yyyy-MM-dd"),
        EndDate: _toDate?.ToString("yyyy-MM-dd"),
        Criteria: BuildOverrideCriteria(),
        SearchEffort: _searchEffort,
        ResearchCompany: _researchCompany,
        ResearchSalary: _researchSalary);

    /// <summary>
    /// The reviewed/edited criteria to run with, or null if the user never analyzed. Persisted with
    /// the run so reloading a previous search restores the edited must-have / nice-to-have / work modes.
    /// </summary>
    private SearchCriteria? BuildOverrideCriteria() =>
        _criteria is null
            ? null
            : _criteria with
            {
                MustHaveSkills = SplitCsv(_mustHaveText),
                NiceToHaveSkills = SplitCsv(_niceToHaveText),
                WorkStyles = WorkingStyleOptions.Where(_editWorkStyles.Contains).ToArray(),
            };

    /// <summary>A short, scannable title summarising the key search points.</summary>
    private static string BuildTitle(SearchInputs i)
    {
        var parts = new List<string>();

        if (i.Roles.Length > 0)
            parts.Add(i.Roles.Length == 1 ? i.Roles[0] : $"{i.Roles[0]} +{i.Roles.Length - 1}");
        if (i.Languages.Length > 0)
            parts.Add(i.Languages.Length == 1 ? i.Languages[0] : $"{i.Languages[0]} +{i.Languages.Length - 1}");
        if (i.WorkingStyles.Length > 0)
            parts.Add(string.Join("/", i.WorkingStyles));
        if (!string.IsNullOrWhiteSpace(i.Location))
            parts.Add(i.Location);

        return parts.Count > 0 ? string.Join(" · ", parts) : "Job search";
    }

    private async Task SaveCvAsync()
    {
        if (string.IsNullOrWhiteSpace(_resume))
            return;

        try
        {
            await Profile.SaveAsync(_resume);
            _savedCvExists = true;
            _profileStatus = "CV saved — it'll be here next time.";
        }
        catch (Exception ex)
        {
            _profileStatus = $"Couldn't save CV: {ex.Message}";
        }
    }

    private async Task ForgetCvAsync()
    {
        await Profile.DeleteAsync();
        _savedCvExists = false;
        _profileStatus = "Saved CV removed.";
    }

    private void SetAllRoles(bool select)
    {
        _selectedRoles.Clear();
        if (select)
            foreach (var role in RoleOptions)
                _selectedRoles.Add(role);
    }

    private void SetAllLanguages(bool select)
    {
        _selectedLanguages.Clear();
        if (select)
            foreach (var lang in LanguageOptions)
                _selectedLanguages.Add(lang);
    }

