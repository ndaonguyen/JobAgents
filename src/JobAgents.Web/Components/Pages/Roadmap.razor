@page "/roadmap"
@rendermode InteractiveServer
@inject IdeaStore Ideas

<PageTitle>Roadmap · JobAgents</PageTitle>

<div class="d-flex align-items-start justify-content-between flex-wrap gap-2">
    <div>
        <h1 class="mb-0">Roadmap</h1>
        <p class="text-muted mb-0">
            Future improvements for engineers to pick up. Capture a story with a title, description and
            acceptance criteria, then break it into sub-tasks.
        </p>
    </div>
    <button class="btn btn-primary" @onclick="ToggleAdd">
        <span class="me-1">@(_adding ? "✕" : "➕")</span> @(_adding ? "Close" : "New story")
    </button>
</div>

@if (_adding)
{
    <div class="card border-primary my-3">
        <div class="card-body">
            <div class="mb-2">
                <label class="form-label fw-semibold">Title</label>
                <input class="form-control" @bind="_newTitle" @bind:event="oninput"
                       placeholder="Short summary of the story" />
            </div>
            <div class="mb-2">
                <label class="form-label fw-semibold">Description</label>
                <textarea class="form-control" rows="4" @bind="_newDescription"
                          placeholder="What should be built and why — context, links, affected files…"></textarea>
            </div>
            <div class="mb-2">
                <label class="form-label fw-semibold">Acceptance criteria</label>
                <textarea class="form-control" rows="3" @bind="_newCriteria"
                          placeholder="Definition of done — one criterion per line"></textarea>
            </div>
            <button class="btn btn-primary" @onclick="AddAsync" disabled="@string.IsNullOrWhiteSpace(_newTitle)">
                Save story
            </button>
            <button type="button" class="btn btn-link" @onclick="CancelAdd">Cancel</button>
        </div>
    </div>
}

@if (_ideas.Count == 0)
{
    <div class="alert alert-light border mt-3">
        No stories yet. Click <strong>New story</strong> to add the first one.
    </div>
}
else
{
    <div class="d-flex flex-wrap gap-2 align-items-center mt-3 mb-3">
        <span class="badge rounded-pill filter-pill @(_filter is null ? "bg-dark" : "bg-light text-dark border")"
              @onclick="() => SetFilter(null)">
            All <span class="ms-1 opacity-75">@_ideas.Count</span>
        </span>
        @foreach (var s in IdeaStore.Statuses)
        {
            var count = _ideas.Count(i => i.Status == s);
            <span class="badge rounded-pill filter-pill @(_filter == s ? StatusClass(s) : "bg-light text-dark border")"
                  @onclick="() => SetFilter(s)">
                @s <span class="ms-1 opacity-75">@count</span>
            </span>
        }
        <input class="form-control form-control-sm ms-auto" style="max-width:18rem"
               placeholder="Search stories…" @bind="_search" @bind:event="oninput" />
    </div>

    @if (Filtered().Count == 0)
    {
        <div class="alert alert-light border">No stories match the current filter.</div>
    }

    <div class="mt-1">
        @foreach (var idea in Filtered())
        {
            var done = idea.SubTasks.Count(s => s.Done);
            var total = idea.SubTasks.Count;
            <div class="card story-card mb-3 @StatusBorder(idea.Status)">
                <div class="card-body">
                    @if (_editingId == idea.Id)
                    {
                        <div class="mb-2">
                            <label class="form-label fw-semibold">Title</label>
                            <input class="form-control" @bind="_editTitle" @bind:event="oninput" />
                        </div>
                        <div class="mb-2">
                            <label class="form-label fw-semibold">Description</label>
                            <textarea class="form-control" rows="4" @bind="_editDescription"></textarea>
                        </div>
                        <div class="mb-2">
                            <label class="form-label fw-semibold">Acceptance criteria</label>
                            <textarea class="form-control" rows="3" @bind="_editCriteria"></textarea>
                        </div>
                        <button class="btn btn-primary btn-sm" @onclick="SaveEditAsync"
                                disabled="@string.IsNullOrWhiteSpace(_editTitle)">Save</button>
                        <button type="button" class="btn btn-link btn-sm" @onclick="CancelEdit">Cancel</button>
                    }
                    else
                    {
                        <div class="d-flex align-items-start justify-content-between gap-2">
                            <h5 class="story-title mb-1">@idea.Title</h5>
                            <div class="d-flex align-items-center gap-2 flex-shrink-0">
                                <span class="badge @StatusClass(idea.Status)">@idea.Status</span>
                                <select class="form-select form-select-sm" style="width:auto"
                                        @onchange="e => UpdateStatusAsync(idea.Id, e.Value?.ToString())">
                                    @foreach (var s in IdeaStore.Statuses)
                                    {
                                        <option value="@s" selected="@(s == idea.Status)">@s</option>
                                    }
                                </select>
                                <button class="btn btn-sm btn-outline-secondary" title="Edit"
                                        @onclick="() => BeginEdit(idea)">✏️</button>
                                <button class="btn btn-sm btn-outline-danger" title="Delete"
                                        @onclick="() => DeleteAsync(idea.Id)">🗑</button>
                            </div>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(idea.Description))
                        {
                            <p class="mb-2 text-body-secondary" style="white-space: pre-wrap;">@idea.Description</p>
                        }

                        @if (!string.IsNullOrWhiteSpace(idea.Criteria))
                        {
                            <div class="mb-3">
                                <div class="section-label mb-1">Acceptance criteria</div>
                                <div class="criteria-box">@idea.Criteria</div>
                            </div>
                        }

                        <div class="border-top pt-3 mt-2">
                            <div class="d-flex align-items-center justify-content-between mb-1">
                                <span class="section-label">Sub-tasks</span>
                                @if (total > 0)
                                {
                                    <span class="small text-muted">@done / @total done</span>
                                }
                            </div>

                            @if (total > 0)
                            {
                                <div class="progress progress-thin mb-2" role="progressbar"
                                     aria-valuenow="@done" aria-valuemin="0" aria-valuemax="@total">
                                    <div class="progress-bar bg-success"
                                         style="width:@(done * 100 / total)%"></div>
                                </div>
                                <ul class="subtask-list mb-2">
                                    @foreach (var task in idea.SubTasks)
                                    {
                                        <li class="subtask-row">
                                            <input class="form-check-input mt-0" type="checkbox" checked="@task.Done"
                                                   @onchange="() => ToggleSubTaskAsync(idea.Id, task.Id)" />
                                            <span class="@(task.Done ? "subtask-done" : "")">@task.Title</span>
                                            <button class="btn btn-sm btn-link text-danger p-0 ms-auto subtask-del"
                                                    title="Delete sub-task"
                                                    @onclick="() => DeleteSubTaskAsync(idea.Id, task.Id)">🗑</button>
                                        </li>
                                    }
                                </ul>
                            }
                            else
                            {
                                <div class="small text-muted mb-2">No sub-tasks yet — add the first below.</div>
                            }

                            <div class="d-flex gap-2">
                                <input class="form-control form-control-sm" style="max-width:24rem"
                                       placeholder="Add a sub-task…"
                                       value="@SubTaskDraft(idea.Id)"
                                       @oninput="e => SetSubTaskDraft(idea.Id, e.Value?.ToString())"
                                       @onkeydown="e => OnSubTaskKeyDown(e, idea.Id)" />
                                <button class="btn btn-sm btn-outline-primary"
                                        disabled="@string.IsNullOrWhiteSpace(SubTaskDraft(idea.Id))"
                                        @onclick="() => AddSubTaskAsync(idea.Id)">Add</button>
                            </div>
                        </div>

                        <div class="small text-muted mt-3">Added @idea.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm") UTC</div>
                    }
                </div>
            </div>
        }
    </div>
}

@code {
    private List<ImprovementIdea> _ideas = new();
    private bool _adding;
    private string _newTitle = string.Empty;
    private string _newDescription = string.Empty;
    private string _newCriteria = string.Empty;

    private string? _editingId;
    private string _editTitle = string.Empty;
    private string _editDescription = string.Empty;
    private string _editCriteria = string.Empty;

    private string? _filter;
    private string _search = string.Empty;

    private readonly Dictionary<string, string> _subTaskDrafts = new();

    protected override async Task OnInitializedAsync() => _ideas = await Ideas.LoadAllAsync();

    private List<ImprovementIdea> Filtered()
    {
        IEnumerable<ImprovementIdea> q = _ideas;
        if (_filter is not null)
            q = q.Where(i => i.Status == _filter);
        if (!string.IsNullOrWhiteSpace(_search))
            q = q.Where(i => i.Title.Contains(_search, StringComparison.OrdinalIgnoreCase)
                          || i.Description.Contains(_search, StringComparison.OrdinalIgnoreCase));
        return q.ToList();
    }

    private void SetFilter(string? status) => _filter = status;

    private void ToggleAdd()
    {
        _adding = !_adding;
        if (!_adding)
            ClearForm();
    }

    private async Task AddAsync()
    {
        if (string.IsNullOrWhiteSpace(_newTitle))
            return;

        await Ideas.AddAsync(_newTitle, _newDescription, _newCriteria);
        ClearForm();
        _adding = false;
        _ideas = await Ideas.LoadAllAsync();
    }

    private void CancelAdd()
    {
        _adding = false;
        ClearForm();
    }

    private void ClearForm()
    {
        _newTitle = string.Empty;
        _newDescription = string.Empty;
        _newCriteria = string.Empty;
    }

    private void BeginEdit(ImprovementIdea idea)
    {
        _editingId = idea.Id;
        _editTitle = idea.Title;
        _editDescription = idea.Description;
        _editCriteria = idea.Criteria;
    }

    private void CancelEdit()
    {
        _editingId = null;
        _editTitle = string.Empty;
        _editDescription = string.Empty;
        _editCriteria = string.Empty;
    }

    private async Task SaveEditAsync()
    {
        if (_editingId is null || string.IsNullOrWhiteSpace(_editTitle))
            return;

        await Ideas.UpdateAsync(_editingId, _editTitle, _editDescription, _editCriteria);
        CancelEdit();
        _ideas = await Ideas.LoadAllAsync();
    }

    private async Task UpdateStatusAsync(string id, string? status)
    {
        if (string.IsNullOrWhiteSpace(status))
            return;

        await Ideas.UpdateStatusAsync(id, status);
        _ideas = await Ideas.LoadAllAsync();
    }

    private async Task DeleteAsync(string id)
    {
        await Ideas.DeleteAsync(id);
        _ideas = await Ideas.LoadAllAsync();
    }

    private string SubTaskDraft(string ideaId) =>
        _subTaskDrafts.TryGetValue(ideaId, out var v) ? v : string.Empty;

    private void SetSubTaskDraft(string ideaId, string? value) =>
        _subTaskDrafts[ideaId] = value ?? string.Empty;

    private async Task OnSubTaskKeyDown(KeyboardEventArgs e, string ideaId)
    {
        if (e.Key == "Enter")
            await AddSubTaskAsync(ideaId);
    }

    private async Task AddSubTaskAsync(string ideaId)
    {
        var title = SubTaskDraft(ideaId);
        if (string.IsNullOrWhiteSpace(title))
            return;

        await Ideas.AddSubTaskAsync(ideaId, title);
        _subTaskDrafts[ideaId] = string.Empty;
        _ideas = await Ideas.LoadAllAsync();
    }

    private async Task ToggleSubTaskAsync(string ideaId, string subTaskId)
    {
        await Ideas.ToggleSubTaskAsync(ideaId, subTaskId);
        _ideas = await Ideas.LoadAllAsync();
    }

    private async Task DeleteSubTaskAsync(string ideaId, string subTaskId)
    {
        await Ideas.DeleteSubTaskAsync(ideaId, subTaskId);
        _ideas = await Ideas.LoadAllAsync();
    }

    private static string StatusClass(string status) => status switch
    {
        "Done" => "bg-success",
        "In Progress" => "bg-primary",
        "Planned" => "bg-info text-dark",
        _ => "bg-secondary",
    };

    private static string StatusBorder(string status) => status switch
    {
        "Done" => "status-done",
        "In Progress" => "status-in-progress",
        "Planned" => "status-planned",
        _ => "status-proposed",
    };
}
